{
  "name": "zod-to-form",
  "version": "0.2.0",
  "private": true,
  "description": "Schema-Driven Form Generation for Zod v4 - walks Zod internal type tree using processor registry pattern to emit React form components instead of JSON Schema",
  "keywords": [
    "zod",
    "forms",
    "form-generation",
    "schema",
    "codegen",
    "react",
    "validation",
    "typescript",
    "ui",
    "components"
  ],
  "type": "module",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/zod-to-form.git"
  },
  "homepage": "https://pradeepmouli.github.io/zod-to-form/",
  "bugs": {
    "url": "https://github.com/pradeepmouli/zod-to-form/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "clean:all": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "dev": "pnpm -r --parallel run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fresh": "pnpm clean:all && pnpm install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "test:watch": "pnpm -r --parallel run test -- --watch",
    "type-check": "pnpm -r run type-check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "prepare": "simple-git-hooks",
    "bench": "vitest bench --config vitest.benchmark.config.ts",
    "bench:gen-fixtures": "pnpm --filter @zod-to-form/react exec tsx tests/performance/gen-fixtures.ts",
    "bench:browser": "pnpm run bench:gen-fixtures && vitest bench --config vitest.browser.config.ts",
    "bench:report": "vitest bench --config vitest.benchmark.config.ts --outputJson bench-results.json && pnpm run bench:browser && tsx scripts/bench-report.ts",
    "docs": "typedoc --plugin typedoc-plugin-to-skills",
    "docs:md": "typedoc",
    "docs:dev": "pnpm --filter @zod-to-form/docs start",
    "docs:build": "pnpm --filter @zod-to-form/docs build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{js,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@to-skills/cli": "^0.3.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "lint-staged": "^17.0.3",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "^1.59.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-to-skills": "1.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.32.0"
  },
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "overrides": {
      "webpack": "5.97.1",
      "serialize-javascript": ">=7.0.5"
    }
  }
}
