{
  "name": "@zodform/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Build-time code generator for Zod v4 form components",
  "type": "module",
  "bin": {
    "zodform": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsgo -p tsconfig.build.json --watch",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@zodform/core": "workspace:*",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  }
}
