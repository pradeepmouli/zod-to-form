{
  "name": "@zod-to-form/react",
  "version": "0.10.0",
  "description": "Runtime <ZodForm> renderer for Zod v4 schemas",
  "license": "MIT",
  "homepage": "https://github.com/pradeepmouli/zod-to-form#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/zod-to-form.git",
    "directory": "packages/react"
  },
  "keywords": [
    "zod",
    "zod-v4",
    "react",
    "forms",
    "form-generation",
    "react-hook-form",
    "schema-driven",
    "dynamic-forms",
    "form-renderer",
    "hookform-resolver",
    "zod-form-renderer"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn/index.d.ts",
      "import": "./dist/shadcn/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "dev": "tsgo -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsgo --noEmit"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@zod-to-form/codegen": "workspace:*",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@zod-to-form/core": "workspace:*"
  },
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "publishConfig": {
    "access": "public"
  }
}
