{
  "name": "@zod-to-form/core",
  "version": "0.2.2",
  "description": "Schema walker and processor registry for Zod v4 form generation",
  "license": "MIT",
  "homepage": "https://github.com/pradeepmouli/zodforms#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/zodforms.git",
    "directory": "packages/core"
  },
  "keywords": ["zod", "forms", "form-generation", "schema", "typescript"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "dev": "tsgo -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsgo --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "^4.3.6"
  }
}
