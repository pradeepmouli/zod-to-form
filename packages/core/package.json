{
  "name": "@zod-to-form/core",
  "version": "0.11.1",
  "description": "Schema walker and processor registry for Zod v4 form generation",
  "license": "MIT",
  "homepage": "https://github.com/pradeepmouli/zod-to-form#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/zod-to-form.git",
    "directory": "packages/core"
  },
  "keywords": [
    "zod",
    "zod-v4",
    "forms",
    "form-generation",
    "schema",
    "schema-walker",
    "processor-registry",
    "react-hook-form",
    "schema-driven",
    "form-schema",
    "zod-registry"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./processors": {
      "types": "./dist/processors/index.d.ts",
      "import": "./dist/processors/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "dev": "tsgo -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsgo --noEmit"
  },
  "peerDependencies": {
    "jiti": "^2.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "jiti": {
      "optional": true
    }
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "type-fest": "^5.7.0",
    "zod": "^4.4.3"
  },
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "publishConfig": {
    "access": "public"
  }
}
