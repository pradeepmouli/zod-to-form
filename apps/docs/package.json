    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@skillit/cli": "^1.1.2",
    "@skillit/core": "^4.0.2",
    "@skillit/docusaurus": "^1.0.3",
    "@testing-library/jest-dom": "^7.0.0",
