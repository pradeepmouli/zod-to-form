{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // @docusaurus/tsconfig sets baseUrl (required by its `@site/*` paths),
    // which TS 6.0 deprecates; silence until Docusaurus migrates.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/", "registry/**/*.ts", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": ["node_modules", "build", ".docusaurus"]
}
